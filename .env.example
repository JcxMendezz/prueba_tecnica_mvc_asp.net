# ===========================================
# CONFIGURACIÓN DE ENTORNO - TEMPLATE
# ===========================================
# Copiar este archivo a .env y configurar los valores

# Entorno: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# Puerto (Render/Railway lo asignan automáticamente)
PORT=8080

# ===========================================
# BASE DE DATOS - DESARROLLO LOCAL
# ===========================================
DB_HOST=localhost
DB_PORT=5433
DB_NAME=task_management_dev
DB_USER=postgres
DB_PASSWORD=keymaster?

# ===========================================
# BASE DE DATOS - PRODUCCIÓN (Render)
# ===========================================
# Render proporciona DATABASE_URL automáticamente
# Formato: postgres://user:password@host:port/database
# DATABASE_URL=postgres://taskflow_user:xxx@xxx.render.com:5432/task_management

# Connection String .NET (alternativa)
# ConnectionStrings__DefaultConnection=Host=xxx;Port=5432;Database=xxx;Username=xxx;Password=xxx;SSL Mode=Require;Trust Server Certificate=true

# ===========================================
# LOGGING
# ===========================================
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
